# ---- Python ----
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- Environments ----
.venv/
venv/
env/
.env
.env.*
!.env.example

# ---- Data (Constitution IV: data files are never committed) ----
# Provenance is documented in docs/data-provenance.md and per-directory READMEs.
# NOTE: these use `dir/*` rather than `dir/` on purpose. A bare `dir/` stops git
# descending into the directory at all, which would make the README negations below
# unreachable dead rules.
data/raw/*
data/interim/*
data/processed/*
data/external/*
*.csv
*.txt
*.parquet
*.feather
*.zip
*.gz

# Re-include the small text files that ARE source, not data:
!data/**/README.md
!requirements*.txt
!**/validation_rules.json
!**/data_dictionary.md

# ---- Run artifacts (regenerated by the pipeline, never hand-edited) ----
artifacts/
outputs/
mlruns/
logs/
*.log
*.joblib
*.pkl

# ---- Deliverables that are build outputs, not source ----
reports/generated/
submission.csv

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
